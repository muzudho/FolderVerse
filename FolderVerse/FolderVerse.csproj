<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    <PackageReference Include="StationeryUI.MonoGame" Version="0.3.0" />
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="Content/Content.mgcb" />
    <None Update="Content/Images/Portraits/*/manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/Images/Portraits/v3-standardized/selected-versions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/Images/Portraits/active-version.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/Images/Portraits/newspaper/*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/Images/Mobs/*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/Images/Setup/*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/Images/Newspapers/*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/Images/NodeSupervisors/*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/Images/robot-map-toy-v001.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Content/Music/*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckStaticFontCoverage" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../tools/FontCoverage/FontCoverage.csproj&quot; --no-launch-profile --configuration &quot;$(Configuration)&quot; -- &quot;$(MSBuildProjectDirectory)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)/.." UseUtf8Encoding="Always" StdOutEncoding="utf-8" StdErrEncoding="utf-8" />
  </Target>
</Project>
