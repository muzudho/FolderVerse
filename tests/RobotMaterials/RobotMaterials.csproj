<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../../FolderVerse/FolderVerse.csproj" Condition="'$(PublishedGame)' == ''" />
    <Reference Include="FolderVerse" Condition="'$(PublishedGame)' != ''"><HintPath>$(PublishedGame)/FolderVerse.dll</HintPath></Reference>
    <Reference Include="MonoGame.Framework" Condition="'$(PublishedGame)' != ''"><HintPath>$(PublishedGame)/MonoGame.Framework.dll</HintPath></Reference>
  </ItemGroup>
</Project>
